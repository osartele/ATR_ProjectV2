@Test
public void testGetPropertyReturnDefaultWhenValueConversionFails()
{
    org.finra.herd.model.dto.ConfigurationValue configurationValueWithStringDefault = null;
    String defaultValue = null;

    Object[] enumConstants = org.finra.herd.model.dto.ConfigurationValue.class.getEnumConstants();
    org.junit.Assert.assertNotNull("ConfigurationValue is expected to be an enum.", enumConstants);

    for (Object enumConstant : enumConstants)
    {
        org.finra.herd.model.dto.ConfigurationValue configurationValue = (org.finra.herd.model.dto.ConfigurationValue) enumConstant;
        Object candidateDefaultValue = configurationValue.getDefaultValue();
        if (candidateDefaultValue instanceof String)
        {
            configurationValueWithStringDefault = configurationValue;
            defaultValue = (String) candidateDefaultValue;
            break;
        }
    }

    org.junit.Assert.assertNotNull("Expected at least one configuration value with a String default.", configurationValueWithStringDefault);

    org.springframework.core.env.Environment environment = org.mockito.Mockito.mock(org.springframework.core.env.Environment.class);

    org.springframework.core.convert.ConversionFailedException conversionFailedException =
        new org.springframework.core.convert.ConversionFailedException(org.springframework.core.convert.TypeDescriptor.valueOf(String.class),
            org.springframework.core.convert.TypeDescriptor.valueOf(String.class), "bad-value", new IllegalArgumentException("conversion failed"));

    org.mockito.Mockito.doThrow(conversionFailedException)
        .when(environment)
        .getProperty(configurationValueWithStringDefault.getKey(), String.class, defaultValue);
    org.mockito.Mockito.doThrow(conversionFailedException)
        .when(environment)
        .getProperty(configurationValueWithStringDefault.getKey(), String.class);

    org.mockito.Mockito.when(environment.getProperty(configurationValueWithStringDefault.getKey(), defaultValue)).thenReturn(defaultValue);
    org.mockito.Mockito.when(environment.getProperty(configurationValueWithStringDefault.getKey())).thenReturn(null);

    org.junit.Assert.assertEquals(defaultValue, org.finra.herd.core.helper.ConfigurationHelper.getProperty(configurationValueWithStringDefault, environment));
}

