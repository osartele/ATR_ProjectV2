import org.mockito.Mockito;

public class SearchIndexUpdateHelperTest
{
    @Test
    public void testModifyTagInSearchIndexSearchIndexUpdateJmsListenerDisabled() throws Exception
    {
        SearchIndexUpdateHelper searchIndexUpdateHelper = new SearchIndexUpdateHelper();
        ConfigurationHelper configurationHelper = Mockito.mock(ConfigurationHelper.class);
        JsonHelper jsonHelper = Mockito.mock(JsonHelper.class);
        TagEntity tagEntity = Mockito.mock(TagEntity.class);

        injectFieldByType(searchIndexUpdateHelper, ConfigurationHelper.class, configurationHelper);
        injectFieldByType(searchIndexUpdateHelper, JsonHelper.class, jsonHelper);

        Long tagId = 1L;
        String modificationType = "UPDATE";
        String searchIndexUpdateDtoAsJson = "searchIndexUpdateDtoAsJson";
        SearchIndexUpdateDto expectedSearchIndexUpdateDto =
            new SearchIndexUpdateDto(MESSAGE_TYPE_TAG_UPDATE, Arrays.asList(tagId), modificationType);

        Mockito.when(tagEntity.getId()).thenReturn(tagId);
        Mockito.when(configurationHelper.getProperty(ConfigurationValue.SEARCH_INDEX_UPDATE_JMS_LISTENER_ENABLED)).thenReturn(Boolean.FALSE.toString());
        Mockito.when(jsonHelper.objectToJson(Mockito.any(SearchIndexUpdateDto.class))).thenReturn(searchIndexUpdateDtoAsJson);
        Mockito.when(jsonHelper.unmarshallJsonToObject(SearchIndexUpdateDto.class, searchIndexUpdateDtoAsJson)).thenReturn(expectedSearchIndexUpdateDto);

        searchIndexUpdateHelper.modifyTagInSearchIndex(tagEntity, modificationType);

        ArgumentCaptor<SearchIndexUpdateDto> searchIndexUpdateDtoArgumentCaptor = ArgumentCaptor.forClass(SearchIndexUpdateDto.class);
        Mockito.verify(jsonHelper).objectToJson(searchIndexUpdateDtoArgumentCaptor.capture());

        SearchIndexUpdateDto actualSearchIndexUpdateDto = searchIndexUpdateDtoArgumentCaptor.getValue();
        Assert.assertNotNull(actualSearchIndexUpdateDto);
        Assert.assertEquals(MESSAGE_TYPE_TAG_UPDATE, actualSearchIndexUpdateDto.getMessageType());

        List<Long> actualTagIds = extractFirstLongListField(actualSearchIndexUpdateDto);
        Assert.assertNotNull(actualTagIds);
        Assert.assertEquals(1, actualTagIds.size());
        Assert.assertEquals(tagId, actualTagIds.get(0));

        Mockito.verify(configurationHelper).getProperty(ConfigurationValue.SEARCH_INDEX_UPDATE_JMS_LISTENER_ENABLED);
        Mockito.verify(jsonHelper).unmarshallJsonToObject(SearchIndexUpdateDto.class, searchIndexUpdateDtoAsJson);
    }

    private void injectFieldByType(Object target, Class<?> fieldType, Object value) throws Exception
    {
        Class<?> currentClass = target.getClass();

